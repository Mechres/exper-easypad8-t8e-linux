/*
 * Copyright 2026 mechres
 * Device Tree for Exper Easypad 8 (Model T8E)
 * Allwinner A31s quad-core tablet
 */

/dts-v1/;
#include "sun6i-a31s.dtsi"
#include "sun6i-reference-design-tablet.dtsi"

/ {
	model = "Exper Easypad T8E";
	compatible = "exper,easypad-t8e", "allwinner,sun6i-a31s";

	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* Allwinner A31s GPL bank base is 181: FEX gpio 186 = 186 - 181 = PL5 */
		reset-gpios = <&r_pio 0 5 GPIO_ACTIVE_LOW>;
		clocks = <&rtc 1>; /* CLK_OSC32K_FANOUT */
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
	};
};

/* PH21 (UART0 RX) is floating — adapter only has RX<->TX
 * and GND connected; crosstalk from TX signal generates ghost DR bit.
 * Adding pull-up to RX pin. */
&pio {
	uart0_ph_pins_pu: uart0-ph-pins-pu {
		pins = "PH20", "PH21";
		function = "uart0";
		bias-pull-up;
	};
};

/* Prevent cpufreq-dt from binding and crashing with nosmp */
&cpu0 {
	/delete-property/ cpu-supply;
	/delete-property/ operating-points;
};

/* AXP221 PMIC is connected via P2WI at 0x68 with NMI interrupt. */
&battery_power_supply {
	status = "okay";
};

&usb_power_supply {
	status = "okay";
};

&ac_power_supply {
	status = "okay";
};

&i2c1 {
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&pio>;
		interrupts = <0 3 IRQ_TYPE_LEVEL_HIGH>; /* PA3 */
		reset-gpios = <&pio 0 2 GPIO_ACTIVE_HIGH>; /* PA2 */
		touchscreen-swapped-x-y;
	};
};

&i2c2 {
	status = "okay";

	accelerometer@19 {
		compatible = "st,lis3dh-accel";
		reg = <0x19>;
		interrupt-parent = <&pio>;
		interrupts = <0 9 IRQ_TYPE_EDGE_RISING>; /* PA9 */
	};
};

&lradc {
	vref-supply = <&reg_aldo3>;
	status = "okay";

	button-1000 {
		label = "Home";
		linux,code = <KEY_HOMEPAGE>;
		channel = <0>;
		voltage = <1000000>;
	};
};

/* MicroSD slot (MMC0) on PF0-PF5 */
&mmc0 {
	/delete-property/ vmmc-supply;
	/delete-property/ cd-gpios;
	broken-cd;
	status = "okay";
};

/* SDIO WiFi (MMC1) on PG0-PG5 */
&mmc1 {
	vmmc-supply = <&reg_dldo1>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
		interrupt-parent = <&r_pio>;
		/* FEX gpio 187 = 187 - 181 = PL6 */
		interrupts = <0 6 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
	};
};

&reg_dldo1 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
	regulator-always-on;
};

&reg_dldo2 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "vcc-pg";
	regulator-always-on;
};

&reg_dldo4 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi-clk";
	regulator-always-on;
};

&reg_dc1sw {
	regulator-always-on;
};

&usbphy {
	/delete-property/ usb0_vbus_power-supply;
	/delete-property/ usb0_vbus-supply;
	/delete-property/ usb1_vbus-supply;
};

/delete-node/ &simplefb_hdmi;

&simplefb_lcd {
	/delete-property/ vcc-lcd-supply;
	/delete-property/ vcc-pg-supply;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins_pu>;
	status = "okay";
};

&r_pio {
	clko_pm7_pin: clko-pm7-pin {
		pins = "PM7";
		function = "rtc";
	};
};

&rtc {
	pinctrl-names = "default";
	pinctrl-0 = <&clko_pm7_pin>;
};

&codec {
	allwinner,audio-routing =
		"Headphone", "HP",
		"Speaker", "LINEOUT",
		"MIC1", "Mic",
		"MIC2", "Headset Mic",
		"Mic", "MBIAS",
		"Headset Mic", "HBIAS";
	allwinner,pa-gpios = <&r_pio 0 4 GPIO_ACTIVE_HIGH>; /* PL4 */
	status = "okay";
};
