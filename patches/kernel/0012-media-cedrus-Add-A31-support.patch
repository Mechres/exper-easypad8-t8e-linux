From a03b01dbc88fa4e2d74913f53e487a59991204bb Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:38:01 +0300
Subject: [PATCH 12/13] media: cedrus: Add A31 support

Reuse the A20 capabilities (MPEG-2, H.264, VP8, tiled output) and the
320 MHz module clock rate.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/staging/media/sunxi/cedrus/cedrus.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index 96acd52e3..6c3970c68 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -579,6 +579,13 @@ static const struct cedrus_variant sun5i_a13_cedrus_variant = {
 	.mod_rate	= 320000000,
 };
 
+static const struct cedrus_variant sun6i_a31_cedrus_variant = {
+	.capabilities	= CEDRUS_CAPABILITY_MPEG2_DEC |
+			  CEDRUS_CAPABILITY_H264_DEC |
+			  CEDRUS_CAPABILITY_VP8_DEC,
+	.mod_rate	= 320000000,
+};
+
 static const struct cedrus_variant sun7i_a20_cedrus_variant = {
 	.capabilities	= CEDRUS_CAPABILITY_MPEG2_DEC |
 			  CEDRUS_CAPABILITY_H264_DEC |
@@ -662,6 +669,10 @@ static const struct of_device_id cedrus_dt_match[] = {
 		.compatible = "allwinner,sun5i-a13-video-engine",
 		.data = &sun5i_a13_cedrus_variant,
 	},
+	{
+		.compatible = "allwinner,sun6i-a31-video-engine",
+		.data = &sun6i_a31_cedrus_variant,
+	},
 	{
 		.compatible = "allwinner,sun7i-a20-video-engine",
 		.data = &sun7i_a20_cedrus_variant,
-- 
