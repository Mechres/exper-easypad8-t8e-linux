From 05f1978793a12fd5c36dc8344f4007478e097059 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Fri, 30 Oct 2026 03:05:15 +0300
Subject: [PATCH] clk: sunxi-ng: sun6i-a31: Let the CPU PLL settle after a rate
 change

On the Exper Easypad T8E (Allwinner A31s) the first cpufreq transition (for
example 1008 -> 720 MHz) hung the whole system without any message. Tracing
the clock path showed the PLL-CPU register being written and the lock bit
(bit 28) already reading as set, so ccu_helper_wait_for_lock() returned at
once and the CPU mux notifier switched the CPU from the 24 MHz bypass back
to a PLL that had not settled yet.

Add CCU_FEATURE_LOCK_DELAY, which waits a fixed time before the lock bit is
polled, and use it for the A31 PLL-CPU. With 100 us the hang was still there,
with 2 ms the tablet ran stress tests over all four OPPs (480-1008 MHz, 1.0 to
1.2 V) without a hang. 2 ms is empirical: the smallest working delay between
100 us and 2 ms was not determined, and the cause (a stale lock bit) is
inferred from the register values and from the timing, not from documentation.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/sunxi-ng/ccu-sun6i-a31.c | 26 ++++++++++++++++++--------
 drivers/clk/sunxi-ng/ccu_common.c    | 12 ++++++++++++
 drivers/clk/sunxi-ng/ccu_common.h    |  1 +
 3 files changed, 31 insertions(+), 8 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun6i-a31.c b/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
index bab65cfe9..6c4e15805 100644
--- a/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
+++ b/drivers/clk/sunxi-ng/ccu-sun6i-a31.c
@@ -29,14 +29,24 @@
 
 #include "ccu-sun6i-a31.h"
 
-static SUNXI_CCU_NKM_WITH_GATE_LOCK(pll_cpu_clk, "pll-cpu",
-				     "osc24M", 0x000,
-				     8, 5,	/* N */
-				     4, 2,	/* K */
-				     0, 2,	/* M */
-				     BIT(31),	/* gate */
-				     BIT(28),	/* lock */
-				     0);
+/*
+ * Same as SUNXI_CCU_NKM_WITH_GATE_LOCK(), but with CCU_FEATURE_LOCK_DELAY: on the
+ * A31s the lock bit is still set right after the factors are written, so the
+ * CPU mux was switched back to a PLL that had not settled yet and the system
+ * hung on the first frequency change.
+ */
+static struct ccu_nkm pll_cpu_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT(8, 5),
+	.k		= _SUNXI_CCU_MULT(4, 2),
+	.m		= _SUNXI_CCU_DIV(0, 2),
+	.common		= {
+		.reg		= 0x000,
+		.features	= CCU_FEATURE_LOCK_DELAY,
+		.hw.init	= CLK_HW_INIT("pll-cpu", "osc24M", &ccu_nkm_ops, 0),
+	},
+};
 
 /*
  * The Audio PLL is supposed to have 4 outputs: 3 fixed factors from
diff --git a/drivers/clk/sunxi-ng/ccu_common.c b/drivers/clk/sunxi-ng/ccu_common.c
index 1c083b4d0..ecefd6ee5 100644
--- a/drivers/clk/sunxi-ng/ccu_common.c
+++ b/drivers/clk/sunxi-ng/ccu_common.c
@@ -7,6 +7,7 @@
 
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
+#include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/iopoll.h>
 #include <linux/module.h>
@@ -16,6 +17,9 @@
 #include "ccu_gate.h"
 #include "ccu_reset.h"
 
+/* Settle time that is not covered by the lock bit, see CCU_FEATURE_LOCK_DELAY */
+#define CCU_LOCK_DELAY_US	2000
+
 struct sunxi_ccu {
 	const struct sunxi_ccu_desc	*desc;
 	spinlock_t			lock;
@@ -35,6 +39,14 @@ void ccu_helper_wait_for_lock(struct ccu_common *common, u32 lock)
 	else
 		addr = common->base + common->reg;
 
+	/*
+	 * The lock bit of these PLLs is still set from the previous lock for a
+	 * while after the factors were changed, so polling it right away returns
+	 * before the PLL has settled.
+	 */
+	if (common->features & CCU_FEATURE_LOCK_DELAY)
+		udelay(CCU_LOCK_DELAY_US);
+
 	WARN_ON(readl_relaxed_poll_timeout(addr, reg, reg & lock, 100, 70000));
 }
 EXPORT_SYMBOL_NS_GPL(ccu_helper_wait_for_lock, "SUNXI_CCU");
diff --git a/drivers/clk/sunxi-ng/ccu_common.h b/drivers/clk/sunxi-ng/ccu_common.h
index bbec283b9..1bb0f3fd7 100644
--- a/drivers/clk/sunxi-ng/ccu_common.h
+++ b/drivers/clk/sunxi-ng/ccu_common.h
@@ -21,6 +21,7 @@
 #define CCU_FEATURE_CLOSEST_RATE	BIT(9)
 #define CCU_FEATURE_DUAL_DIV		BIT(10)
 #define CCU_FEATURE_UPDATE_BIT		BIT(11)
+#define CCU_FEATURE_LOCK_DELAY		BIT(12)
 
 /* MMC timing mode switch bit */
 #define CCU_MMC_NEW_TIMING_MODE		BIT(30)
-- 
2.56.0

