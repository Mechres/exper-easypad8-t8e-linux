From 047a9c8cacd425474e0861775a68cdc39a1a1d24 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:37:37 +0300
Subject: [PATCH] ARM: dts: sun6i: exper-t8e: Enable HDMI in the DRM variant

Add an hdmi-connector and enable the A31 HDMI controller (&hdmi) in
sun6i-a31s-exper-t8e-drm.dts. It needs CONFIG_DRM_SUN4I_HDMI.

Verified on the tablet: HDMI-A-1 is detected with its EDID modes, runs
1920x1080@60 on its own CRTC next to the 1024x768 LVDS panel, and
reconnecting the cable restores the picture. HDMI audio and CEC were not
tested.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../allwinner/sun6i-a31s-exper-t8e-drm.dts    | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun6i-a31s-exper-t8e-drm.dts b/arch/arm/boot/dts/allwinner/sun6i-a31s-exper-t8e-drm.dts
index 8fcc061a6..8b745b24f 100644
--- a/arch/arm/boot/dts/allwinner/sun6i-a31s-exper-t8e-drm.dts
+++ b/arch/arm/boot/dts/allwinner/sun6i-a31s-exper-t8e-drm.dts
@@ -40,6 +40,17 @@ panel_input: endpoint {
 		};
 	};
 
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
 	backlight: backlight {
 		compatible = "pwm-backlight";
 		pwms = <&pwm 0 20000 0>; /* PH13/pwm0, 50 kHz (lcd_pwm_freq) */
@@ -102,3 +113,13 @@ tcon0_out_lvds: endpoint@0 {
 &de {
 	status = "okay";
 };
+
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
-- 
2.56.0

