From e0b09fd8aaa4b5a1a12876e7a96b6fdcb3f73b6d Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Sun, 25 Oct 2026 15:52:54 +0300
Subject: [PATCH 02/13] ARM: dts: sun6i: Drop cpu-registers-not-fw-configured
 from arch timer

When U-Boot boots in Non-Secure mode with PSCI enabled, the kernel
must use the virtual timer PPI rather than the secure physical PPI.
Leaving this property set forces arm_arch_timer.c to use
ARCH_TIMER_PHYS_SECURE_PPI, which traps as an Undefined Instruction
in time_init() when running in Non-Secure mode.
---
 arch/arm/boot/dts/allwinner/sun6i-a31.dtsi | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/allwinner/sun6i-a31.dtsi b/arch/arm/boot/dts/allwinner/sun6i-a31.dtsi
index f0145d6b9..224696213 100644
--- a/arch/arm/boot/dts/allwinner/sun6i-a31.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun6i-a31.dtsi
@@ -92,7 +92,15 @@ timer {
 			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
 			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
 		clock-frequency = <24000000>;
-		arm,cpu-registers-not-fw-configured;
+		/*
+		 * Removed for Exper Easypad T8E: U-Boot now boots Non-Secure
+		 * with PSCI/HYP enabled (Finding 3), so the kernel must use
+		 * the normal (virtual) timer PPI, not the secure physical one.
+		 * Leaving this quirk set makes arm_arch_timer.c force
+		 * ARCH_TIMER_PHYS_SECURE_PPI, which traps as an Undefined
+		 * Instruction in time_init() when running Non-Secure, hanging
+		 * the boot right after "Starting kernel ..." (Finding 6).
+		 */
 	};
 
 	cpus {
