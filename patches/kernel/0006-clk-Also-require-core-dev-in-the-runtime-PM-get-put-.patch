From 5603e77a3673c049c445f996dabde324a5ca5120 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Tue, 27 Oct 2026 01:18:20 +0300
Subject: [PATCH 06/13] clk: Also require core->dev in the runtime PM get/put
 helpers

clk_pm_runtime_get()/put() only test core->rpm_enabled before using core->dev. Make them
bail out when core->dev is NULL as well.

Carried over from the Exper Easypad T8E (Allwinner A31s) bring-up tree, where this was
applied while chasing a hang in the i2c1 (mv64xxx) runtime resume path before the AXP221
PMIC probed. The exact trigger was not isolated, so treat this as a defensive fix.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/clk.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index 048adfa86..77ed22e70 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -120,7 +120,7 @@ struct clk {
 /***           runtime pm          ***/
 static int clk_pm_runtime_get(struct clk_core *core)
 {
-	if (!core->rpm_enabled)
+	if (!core->rpm_enabled || !core->dev)
 		return 0;
 
 	return pm_runtime_resume_and_get(core->dev);
@@ -128,7 +128,7 @@ static int clk_pm_runtime_get(struct clk_core *core)
 
 static void clk_pm_runtime_put(struct clk_core *core)
 {
-	if (!core->rpm_enabled)
+	if (!core->rpm_enabled || !core->dev)
 		return;
 
 	pm_runtime_put_sync(core->dev);
-- 
2.56.0

