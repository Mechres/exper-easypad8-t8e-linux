+#define SUN4I_HDMI_AUD_CTRL_ENABLE		BIT(31)
+#define SUN4I_HDMI_AUD_CTRL_RESET		BIT(30)
+
+#define SUN4I_HDMI_ADMA_CTRL_REG	0x044
+#define SUN4I_HDMI_ADMA_CTRL_NORMAL_DMA		BIT(31)
+#define SUN4I_HDMI_ADMA_CTRL_REQ_HALF		(0 << 24)
+#define SUN4I_HDMI_ADMA_CTRL_ONE_SAMPLE		BIT(19)
+#define SUN4I_HDMI_ADMA_CTRL_MSB_ALIGN		BIT(18)
