From 1b02e230499e3758ecb1885f5eb50261f59e7316 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Sat, 31 Oct 2026 06:44:26 +0300
Subject: [PATCH 4/4] mm: drop __GFP_HIGHMEM from __vmalloc on new kernels

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 services4/srvkm/env/linux/mm.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services4/srvkm/env/linux/mm.c b/services4/srvkm/env/linux/mm.c
index c7e1c0a..5696e8a 100644
--- a/services4/srvkm/env/linux/mm.c
+++ b/services4/srvkm/env/linux/mm.c
@@ -516,7 +516,8 @@ _VMallocWrapper(IMG_SIZE_T uiBytes,
 #else
 	gfp_mask |= __GFP_DMA;
 #endif
-#else
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 9, 0)
+	/* newer __vmalloc() rejects zone modifiers; it uses highmem anyway */
 	gfp_mask |= __GFP_HIGHMEM;
 #endif
 
