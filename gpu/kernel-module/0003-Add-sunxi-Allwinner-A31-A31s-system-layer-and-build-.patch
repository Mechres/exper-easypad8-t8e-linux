+SUPPORT_DRI_DRM := 1
+PVR_LDM_DEVICE_TREE := 1
+PVR_DRI_DRM_PLATFORM_DEV := 1
+SUPPORT_DMABUF := 1
+
+PVR_DRM_MODESET_DRIVER_NAME := sun4i-drm
+PVR_DRM_MODESET_MODULE_NAME := dumb
