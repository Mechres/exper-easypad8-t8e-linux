From dcf6f42610db4740ca3dc49d4567219e08ac81c7 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Sat, 31 Oct 2026 07:12:28 +0300
Subject: [PATCH 06/11] mm: no __GFP_HIGHMEM for __vmalloc on new kernels; vmap
 takes VM_MAP, not gfp

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 services4/srvkm/env/linux/mm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/services4/srvkm/env/linux/mm.c b/services4/srvkm/env/linux/mm.c
index cae4ed9..25becd2 100644
--- a/services4/srvkm/env/linux/mm.c
+++ b/services4/srvkm/env/linux/mm.c
@@ -504,7 +504,8 @@ _VMallocWrapper(IMG_SIZE_T uiBytes,
 
 #if defined(PVR_USE_DMA32_FOR_DEVMEM_ALLOCS)
 	gfp_mask |= __GFP_DMA32;
-#else
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 9, 0)
+	/* newer __vmalloc() rejects zone modifiers; it uses highmem anyway */
 	gfp_mask |= __GFP_HIGHMEM;
 #endif
 
@@ -566,7 +567,7 @@ _VMapWrapper(struct page **ppsPageList, IMG_UINT32 ui32NumPages, IMG_UINT32 ui32
             return NULL;
     }
 
-    pvRet = vmap(ppsPageList, ui32NumPages, GFP_KERNEL | __GFP_HIGHMEM, PGProtFlags);
+    pvRet = vmap(ppsPageList, ui32NumPages, VM_MAP, PGProtFlags);	/* third argument is VM_* flags, not gfp */
 
 #if defined(DEBUG_LINUX_MEMORY_ALLOCATIONS)
     if (pvRet)
-- 
2.56.0

