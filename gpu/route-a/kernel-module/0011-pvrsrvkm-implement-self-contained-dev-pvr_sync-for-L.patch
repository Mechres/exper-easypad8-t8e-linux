diff --git a/services4/srvkm/env/linux/pvr_sync.c b/services4/srvkm/env/linux/pvr_sync.c
new file mode 100644
index 0000000..e24d7ac
--- /dev/null
+++ b/services4/srvkm/env/linux/pvr_sync.c
@@ -0,0 +1,1129 @@
+// SPDX-License-Identifier: Dual MIT/GPL-2.0
+/*************************************************************************/ /*!
+@File           pvr_sync.c
+@Title          Kernel driver for Android's sync mechanism (Linux 7.2 port)
+@Copyright      Copyright (c) Imagination Technologies Ltd. All Rights Reserved
+@License        Dual MIT/GPLv2
+*/ /**************************************************************************/
+
+#include "pvr_sync.h"
+
+#include <linux/kernel.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/uaccess.h>
+#include <linux/types.h>
+#include <linux/atomic.h>
+#include <linux/anon_inodes.h>
+#include <linux/seq_file.h>
+#include <linux/poll.h>
+#include <linux/wait.h>
+#include <linux/sched.h>
+#include <linux/kref.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#include "services_headers.h"
+#include "sgxutils.h"
+#include "ttrace.h"
+#include "mutex.h"
+#include "lock.h"
+
+#if !defined(PVR_LINUX_MISR_USING_WORKQUEUE) && \
+    !defined(PVR_LINUX_MISR_USING_PRIVATE_WORKQUEUE)
+#error The Android sync driver requires that the SGX MISR runs in wq context
+#endif
+
+/* Legacy Android <linux/sync.h> ioctl ABI expected by libsync.so & gralloc */
+#define SYNC_IOC_MAGIC		'>'
+
+struct sync_merge_data {
+	__s32	fd2;
+	char	name[32];
+	__s32	fence;
+};
+
+struct sync_pt_info {
+	__u32	len;
+	char	obj_name[32];
+	char	driver_name[32];
+	__s32	status;
+	__u64	timestamp_ns;
+	__u8	driver_data[];
+};
+
+struct sync_fence_info_data {
+	__u32	len;
+	char	name[32];
+	__s32	status;
+	__u8	pt_info[];
+};
+
+#define SYNC_IOC_WAIT		_IOW(SYNC_IOC_MAGIC, 0, __s32)
+#define SYNC_IOC_MERGE		_IOWR(SYNC_IOC_MAGIC, 1, struct sync_merge_data)
+#define SYNC_IOC_FENCE_INFO	_IOWR(SYNC_IOC_MAGIC, 2, struct sync_fence_info_data)
+
+/* Local wrapper around PVRSRV_KERNEL_SYNC_INFO to add a defer-free list head */
+struct PVR_SYNC_KERNEL_SYNC_INFO {
+	PVRSRV_KERNEL_SYNC_INFO	*psBase;
+	struct list_head	sHead;
+};
+
+struct PVR_SYNC_TIMELINE {
+	struct kref				sKref;
+	char					szName[32];
+	struct list_head			sTimelineList;
+	IMG_UINT32				ui32LastWriteOpsComplete;
+	IMG_BOOL				bSyncHasSignaled;
+	struct mutex				sTimelineLock;
+	struct PVR_SYNC_KERNEL_SYNC_INFO	*psSyncInfo;
+};
+
+struct PVR_SYNC_DATA {
+	struct PVR_SYNC_KERNEL_SYNC_INFO	*psSyncInfo;
+	atomic_t				sRefcount;
+	IMG_UINT32				ui32WOPSnapshot;
+	IMG_UINT64				ui64Stamp;
+};
+
+struct PVR_ALLOC_SYNC_DATA {
+	struct PVR_SYNC_KERNEL_SYNC_INFO	*psSyncInfo;
+	struct PVR_SYNC_TIMELINE		*psTimeline;
+	struct file				*psFile;
+};
+
+struct sync_fence {
+	char			name[32];
+	struct file		*file;
+	IMG_UINT32		num_pts;
+	struct PVR_SYNC_DATA	*pts[SGX_MAX_SRC_SYNCS_TA];
+};
+
+static struct {
+	IMG_UINT32	ui32Pid;
+	IMG_HANDLE	hDevCookie;
+	IMG_HANDLE	hDevMemContext;
+} gsSyncServicesConnection;
+
+static struct workqueue_struct *gpsWorkQueue;
+static struct work_struct gsWork;
+
+static LIST_HEAD(gTimelineList);
+static DEFINE_MUTEX(gTimelineListLock);
+
+static LIST_HEAD(gSyncInfoFreeList);
+static DEFINE_SPINLOCK(gSyncInfoFreeListLock);
+
+static DECLARE_WAIT_QUEUE_HEAD(gPVRSyncWaitQueue);
+
+static IMG_UINT64 gui64SyncPointStamp;
+
+static struct PVR_ALLOC_SYNC_DATA *PVRSyncAllocFDGet(int fd);
+
+static IMG_BOOL PVRSyncIsSyncInfoInUse(PVRSRV_KERNEL_SYNC_INFO *psSyncInfo)
+{
+	return !(psSyncInfo->psSyncData->ui32WriteOpsPending ==
+		 psSyncInfo->psSyncData->ui32WriteOpsComplete &&
+		 psSyncInfo->psSyncData->ui32ReadOpsPending ==
+		 psSyncInfo->psSyncData->ui32ReadOpsComplete &&
+		 psSyncInfo->psSyncData->ui32ReadOps2Pending ==
+		 psSyncInfo->psSyncData->ui32ReadOps2Complete);
+}
+
+static void PVRSyncReleaseSyncInfo(struct PVR_SYNC_KERNEL_SYNC_INFO *psSyncInfo)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&gSyncInfoFreeListLock, flags);
+	list_add_tail(&psSyncInfo->sHead, &gSyncInfoFreeList);
+	spin_unlock_irqrestore(&gSyncInfoFreeListLock, flags);
+
+	if (gpsWorkQueue)
+		queue_work(gpsWorkQueue, &gsWork);
+}
+
+static void PVRSyncPutSyncData(struct PVR_SYNC_DATA *psSyncData)
+{
+	if (!psSyncData)
+		return;
+	if (atomic_dec_and_test(&psSyncData->sRefcount)) {
+		PVRSyncReleaseSyncInfo(psSyncData->psSyncInfo);
+		psSyncData->psSyncInfo = NULL;
+		kfree(psSyncData);
+	}
+}
+
+static void PVRSyncTimelineReleaseKref(struct kref *psKref)
+{
+	struct PVR_SYNC_TIMELINE *psTimeline =
+		container_of(psKref, struct PVR_SYNC_TIMELINE, sKref);
+
+	if (psTimeline->psSyncInfo) {
+		PVRSyncReleaseSyncInfo(psTimeline->psSyncInfo);
+		psTimeline->psSyncInfo = NULL;
+	}
+	kfree(psTimeline);
+}
+
+static IMG_BOOL PVRFenceIsPointSignaled(struct PVR_SYNC_DATA *psSyncData)
+{
+	PVRSRV_SYNC_DATA *psData = psSyncData->psSyncInfo->psBase->psSyncData;
+
+	return (psData->ui32WriteOpsComplete >= psData->ui32WriteOpsPending) ?
+		IMG_TRUE : IMG_FALSE;
+}
+
+static IMG_BOOL PVRFenceIsSignaled(struct sync_fence *psFence)
+{
+	IMG_UINT32 i;
+
+	for (i = 0; i < psFence->num_pts; i++) {
+		if (!PVRFenceIsPointSignaled(psFence->pts[i]))
+			return IMG_FALSE;
+	}
+	return IMG_TRUE;
+}
+
+static __poll_t PVRFencePoll(struct file *file, poll_table *wait)
+{
+	struct sync_fence *psFence = file->private_data;
+
+	poll_wait(file, &gPVRSyncWaitQueue, wait);
+	if (PVRFenceIsSignaled(psFence))
+		return EPOLLIN | EPOLLRDNORM;
+	return 0;
+}
+
+static int PVRFenceRelease(struct inode *inode, struct file *file)
+{
+	struct sync_fence *psFence = file->private_data;
+	IMG_UINT32 i;
+
+	if (!psFence)
+		return 0;
+
+	for (i = 0; i < psFence->num_pts; i++) {
+		PVRSyncPutSyncData(psFence->pts[i]);
+		psFence->pts[i] = NULL;
+	}
+	kfree(psFence);
+	return 0;
+}
+
+static const struct file_operations gsPVRFenceFOps;
+
+static struct sync_fence *sync_fence_fdget(int fd)
+{
+	struct file *file = fget(fd);
+
+	if (!file)
+		return NULL;
+	if (file->f_op != &gsPVRFenceFOps) {
+		fput(file);
+		return NULL;
+	}
+	return file->private_data;
+}
+
+static void sync_fence_put(struct sync_fence *psFence)
+{
+	if (psFence && psFence->file)
+		fput(psFence->file);
+}
+
+static IMG_BOOL
+PVRSyncIsDuplicate(PVRSRV_KERNEL_SYNC_INFO *psA, PVRSRV_KERNEL_SYNC_INFO *psB)
+{
+	return psA->sWriteOpsCompleteDevVAddr.uiAddr ==
+	       psB->sWriteOpsCompleteDevVAddr.uiAddr ? IMG_TRUE : IMG_FALSE;
+}
+
+static long PVRFenceWait(struct sync_fence *psFence, void __user *pvData)
+{
+	__s32 iTimeoutMs;
+	long lTimeoutJiffies;
+	long lRet;
+
+	if (copy_from_user(&iTimeoutMs, pvData, sizeof(iTimeoutMs)))
+		return -EFAULT;
+
+	if (PVRFenceIsSignaled(psFence))
+		return 0;
+
+	if (iTimeoutMs == 0)
+		return -ETIME;
+
+	if (iTimeoutMs < 0)
+		lTimeoutJiffies = MAX_SCHEDULE_TIMEOUT;
+	else
+		lTimeoutJiffies = msecs_to_jiffies(iTimeoutMs);
+
+	lRet = wait_event_interruptible_timeout(gPVRSyncWaitQueue,
+						PVRFenceIsSignaled(psFence),
+						lTimeoutJiffies);
+	if (lRet < 0)
+		return lRet;
+	if (lRet == 0)
+		return -ETIME;
+	return 0;
+}
+
+static long PVRFenceMerge(struct sync_fence *psFence1, void __user *pvData)
+{
+	struct sync_merge_data sMerge;
+	struct sync_fence *psFence2;
+	struct sync_fence *psMerged;
+	struct file *psFile;
+	int iFd;
+	IMG_UINT32 i, j;
+
+	if (copy_from_user(&sMerge, pvData, sizeof(sMerge)))
+		return -EFAULT;
+
+	psFence2 = sync_fence_fdget(sMerge.fd2);
+	if (!psFence2)
+		return -ENOENT;
+
+	iFd = get_unused_fd_flags(O_CLOEXEC);
+	if (iFd < 0) {
+		sync_fence_put(psFence2);
+		return iFd;
+	}
+
+	psMerged = kzalloc(sizeof(*psMerged), GFP_KERNEL);
+	if (!psMerged) {
+		put_unused_fd(iFd);
+		sync_fence_put(psFence2);
+		return -ENOMEM;
+	}
+
+	strscpy(psMerged->name, sMerge.name, sizeof(psMerged->name));
+
+	for (i = 0; i < psFence1->num_pts && psMerged->num_pts < SGX_MAX_SRC_SYNCS_TA; i++) {
+		atomic_inc(&psFence1->pts[i]->sRefcount);
+		psMerged->pts[psMerged->num_pts++] = psFence1->pts[i];
+	}
+
+	for (i = 0; i < psFence2->num_pts && psMerged->num_pts < SGX_MAX_SRC_SYNCS_TA; i++) {
+		IMG_BOOL bDup = IMG_FALSE;
+
+		for (j = 0; j < psMerged->num_pts; j++) {
+			if (PVRSyncIsDuplicate(psMerged->pts[j]->psSyncInfo->psBase,
+					       psFence2->pts[i]->psSyncInfo->psBase)) {
+				bDup = IMG_TRUE;
+				break;
+			}
+		}
+		if (!bDup) {
+			atomic_inc(&psFence2->pts[i]->sRefcount);
+			psMerged->pts[psMerged->num_pts++] = psFence2->pts[i];
+		}
+	}
+
+	sync_fence_put(psFence2);
+
+	psFile = anon_inode_getfile("pvr_sync_fence", &gsPVRFenceFOps,
+				    psMerged, O_RDONLY | O_CLOEXEC);
+	if (IS_ERR_OR_NULL(psFile)) {
+		for (i = 0; i < psMerged->num_pts; i++)
+			PVRSyncPutSyncData(psMerged->pts[i]);
+		kfree(psMerged);
+		put_unused_fd(iFd);
+		return -ENOMEM;
+	}
+
+	psMerged->file = psFile;
+	sMerge.fence = iFd;
+
+	if (copy_to_user(pvData, &sMerge, sizeof(sMerge))) {
+		fput(psFile);
+		put_unused_fd(iFd);
+		return -EFAULT;
+	}
+
+	fd_install(iFd, psFile);
+	return 0;
+}
+
+static long PVRFenceInfo(struct sync_fence *psFence, void __user *pvData)
+{
+	struct sync_fence_info_data sHeader;
+	__u32 ui32MaxLen;
+	__u32 ui32Offset;
+	IMG_UINT32 i;
+
+	if (copy_from_user(&sHeader, pvData, sizeof(sHeader)))
+		return -EFAULT;
+
+	ui32MaxLen = sHeader.len;
+	if (ui32MaxLen < sizeof(sHeader))
+		return -EINVAL;
+
+	strscpy(sHeader.name, psFence->name, sizeof(sHeader.name));
+	sHeader.status = PVRFenceIsSignaled(psFence) ? 1 : 0;
+
+	ui32Offset = sizeof(sHeader);
+	for (i = 0; i < psFence->num_pts; i++) {
+		struct sync_pt_info sPtInfo;
+
+		if (ui32Offset + sizeof(sPtInfo) > ui32MaxLen)
+			break;
+
+		memset(&sPtInfo, 0, sizeof(sPtInfo));
+		sPtInfo.len = sizeof(sPtInfo);
+		strscpy(sPtInfo.obj_name, "pvr_sync", sizeof(sPtInfo.obj_name));
+		strscpy(sPtInfo.driver_name, "pvr_sync", sizeof(sPtInfo.driver_name));
+		sPtInfo.status = PVRFenceIsPointSignaled(psFence->pts[i]) ? 1 : 0;
+		sPtInfo.timestamp_ns = ktime_get_ns();
+
+		if (copy_to_user((__u8 __user *)pvData + ui32Offset,
+				 &sPtInfo, sizeof(sPtInfo)))
+			return -EFAULT;
+
+		ui32Offset += sizeof(sPtInfo);
+	}
+
+	sHeader.len = ui32Offset;
+	if (copy_to_user(pvData, &sHeader, sizeof(sHeader)))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long PVRFenceIOCTL(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct sync_fence *psFence = file->private_data;
+	void __user *pvData = (void __user *)arg;
+
+	switch (cmd) {
+	case SYNC_IOC_WAIT:
+		return PVRFenceWait(psFence, pvData);
+	case SYNC_IOC_MERGE:
+		return PVRFenceMerge(psFence, pvData);
+	case SYNC_IOC_FENCE_INFO:
+		return PVRFenceInfo(psFence, pvData);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations gsPVRFenceFOps = {
+	.owner		= THIS_MODULE,
+	.poll		= PVRFencePoll,
+	.unlocked_ioctl	= PVRFenceIOCTL,
+	.release	= PVRFenceRelease,
+};
+
+static PVRSRV_ERROR PVRSyncInitServices(void)
+{
+	IMG_BOOL bCreated, bShared[PVRSRV_MAX_CLIENT_HEAPS];
+	PVRSRV_HEAP_INFO sHeapInfo[PVRSRV_MAX_CLIENT_HEAPS];
+	IMG_UINT32 ui32ClientHeapCount = 0;
+	PVRSRV_PER_PROCESS_DATA *psPerProc;
+	PVRSRV_ERROR eError;
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+
+	gsSyncServicesConnection.ui32Pid = OSGetCurrentProcessIDKM();
+
+	eError = PVRSRVProcessConnect(gsSyncServicesConnection.ui32Pid, 0);
+	if (eError != PVRSRV_OK) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: PVRSRVProcessConnect failed", __func__));
+		goto err_unlock;
+	}
+
+	psPerProc = PVRSRVFindPerProcessData();
+	if (!psPerProc) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: PVRSRVFindPerProcessData failed", __func__));
+		eError = PVRSRV_ERROR_HANDLE_NOT_FOUND;
+		goto err_disconnect;
+	}
+
+	eError = PVRSRVAcquireDeviceDataKM(0, PVRSRV_DEVICE_TYPE_SGX,
+					   &gsSyncServicesConnection.hDevCookie);
+	if (eError != PVRSRV_OK || !gsSyncServicesConnection.hDevCookie) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: PVRSRVAcquireDeviceDataKM failed", __func__));
+		goto err_disconnect;
+	}
+
+	eError = PVRSRVCreateDeviceMemContextKM(gsSyncServicesConnection.hDevCookie,
+						psPerProc,
+						&gsSyncServicesConnection.hDevMemContext,
+						&ui32ClientHeapCount,
+						&sHeapInfo[0],
+						&bCreated,
+						&bShared[0]);
+	if (eError != PVRSRV_OK || !gsSyncServicesConnection.hDevMemContext) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: PVRSRVCreateDeviceMemContextKM failed", __func__));
+		goto err_disconnect;
+	}
+
+err_unlock:
+	LinuxUnLockMutex(&gPVRSRVLock);
+	return eError;
+
+err_disconnect:
+	PVRSRVProcessDisconnect(gsSyncServicesConnection.ui32Pid);
+	goto err_unlock;
+}
+
+static void PVRSyncCloseServices(void)
+{
+	IMG_BOOL bDummy;
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+
+	PVRSRVDestroyDeviceMemContextKM(gsSyncServicesConnection.hDevCookie,
+					gsSyncServicesConnection.hDevMemContext,
+					&bDummy);
+	gsSyncServicesConnection.hDevMemContext = NULL;
+	gsSyncServicesConnection.hDevCookie = NULL;
+
+	PVRSRVProcessDisconnect(gsSyncServicesConnection.ui32Pid);
+	gsSyncServicesConnection.ui32Pid = 0;
+
+	LinuxUnLockMutex(&gPVRSRVLock);
+}
+
+static struct PVR_SYNC_TIMELINE *PVRSyncCreateTimeline(const IMG_CHAR *pszName)
+{
+	struct PVR_SYNC_TIMELINE *psTimeline;
+	PVRSRV_ERROR eError;
+
+	psTimeline = kzalloc(sizeof(*psTimeline), GFP_KERNEL);
+	if (!psTimeline)
+		return NULL;
+
+	kref_init(&psTimeline->sKref);
+	strscpy(psTimeline->szName, pszName, sizeof(psTimeline->szName));
+	mutex_init(&psTimeline->sTimelineLock);
+
+	psTimeline->psSyncInfo =
+		kzalloc(sizeof(struct PVR_SYNC_KERNEL_SYNC_INFO), GFP_KERNEL);
+	if (!psTimeline->psSyncInfo) {
+		kfree(psTimeline);
+		return NULL;
+	}
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+	eError = PVRSRVAllocSyncInfoKM(gsSyncServicesConnection.hDevCookie,
+				       gsSyncServicesConnection.hDevMemContext,
+				       &psTimeline->psSyncInfo->psBase);
+	LinuxUnLockMutex(&gPVRSRVLock);
+
+	if (eError != PVRSRV_OK) {
+		kfree(psTimeline->psSyncInfo);
+		kfree(psTimeline);
+		return NULL;
+	}
+
+	return psTimeline;
+}
+
+static int PVRSyncOpen(struct inode *inode, struct file *file)
+{
+	struct PVR_SYNC_TIMELINE *psTimeline;
+	IMG_CHAR task_comm[TASK_COMM_LEN + 1];
+
+	get_task_comm(task_comm, current);
+
+	psTimeline = PVRSyncCreateTimeline(task_comm);
+	if (!psTimeline)
+		return -ENOMEM;
+
+	mutex_lock(&gTimelineListLock);
+	list_add_tail(&psTimeline->sTimelineList, &gTimelineList);
+	mutex_unlock(&gTimelineListLock);
+
+	file->private_data = psTimeline;
+	return 0;
+}
+
+static int PVRSyncRelease(struct inode *inode, struct file *file)
+{
+	struct PVR_SYNC_TIMELINE *psTimeline = file->private_data;
+
+	mutex_lock(&gTimelineListLock);
+	list_del(&psTimeline->sTimelineList);
+	mutex_unlock(&gTimelineListLock);
+
+	kref_put(&psTimeline->sKref, PVRSyncTimelineReleaseKref);
+	return 0;
+}
+
+static int PVRSyncFenceAllocRelease(struct inode *inode, struct file *file)
+{
+	struct PVR_ALLOC_SYNC_DATA *psAllocSyncData = file->private_data;
+
+	if (psAllocSyncData->psSyncInfo) {
+		PVRSyncReleaseSyncInfo(psAllocSyncData->psSyncInfo);
+		psAllocSyncData->psSyncInfo = NULL;
+	}
+	if (psAllocSyncData->psTimeline) {
+		kref_put(&psAllocSyncData->psTimeline->sKref,
+			 PVRSyncTimelineReleaseKref);
+		psAllocSyncData->psTimeline = NULL;
+	}
+	kfree(psAllocSyncData);
+	return 0;
+}
+
+static const struct file_operations gsSyncFenceAllocFOps = {
+	.owner		= THIS_MODULE,
+	.release	= PVRSyncFenceAllocRelease,
+};
+
+static struct PVR_ALLOC_SYNC_DATA *PVRSyncAllocFDGet(int fd)
+{
+	struct file *file = fget(fd);
+
+	if (!file)
+		return NULL;
+	if (file->f_op != &gsSyncFenceAllocFOps) {
+		fput(file);
+		return NULL;
+	}
+	return file->private_data;
+}
+
+static long
+PVRSyncIOCTLAlloc(struct PVR_SYNC_TIMELINE *psTimeline, void __user *pvData)
+{
+	struct PVR_ALLOC_SYNC_DATA *psAllocSyncData;
+	int err = -EFAULT, iFd = get_unused_fd_flags(O_CLOEXEC);
+	struct PVR_SYNC_ALLOC_IOCTL_DATA sData;
+	PVRSRV_SYNC_DATA *psSyncData;
+	struct file *psFile;
+	PVRSRV_ERROR eError;
+
+	if (iFd < 0)
+		return iFd;
+
+	if (copy_from_user(&sData, pvData, sizeof(sData)))
+		goto err_put_fd;
+
+	psAllocSyncData = kzalloc(sizeof(*psAllocSyncData), GFP_KERNEL);
+	if (!psAllocSyncData) {
+		err = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	psAllocSyncData->psSyncInfo =
+		kzalloc(sizeof(struct PVR_SYNC_KERNEL_SYNC_INFO), GFP_KERNEL);
+	if (!psAllocSyncData->psSyncInfo) {
+		err = -ENOMEM;
+		goto err_free_alloc_sync_data;
+	}
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+	eError = PVRSRVAllocSyncInfoKM(gsSyncServicesConnection.hDevCookie,
+				       gsSyncServicesConnection.hDevMemContext,
+				       &psAllocSyncData->psSyncInfo->psBase);
+	LinuxUnLockMutex(&gPVRSRVLock);
+
+	if (eError != PVRSRV_OK) {
+		err = -ENOMEM;
+		goto err_free_sync_info;
+	}
+
+	psFile = anon_inode_getfile("pvr_sync_alloc",
+				    &gsSyncFenceAllocFOps, psAllocSyncData, 0);
+	if (IS_ERR_OR_NULL(psFile)) {
+		err = -ENOMEM;
+		goto err_release_sync_info;
+	}
+
+	sData.fence = iFd;
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+	psSyncData = psTimeline->psSyncInfo->psBase->psSyncData;
+	if (psSyncData->ui32WriteOpsPending == psSyncData->ui32WriteOpsComplete)
+		sData.bTimelineIdle = IMG_TRUE;
+	else
+		sData.bTimelineIdle = IMG_FALSE;
+	LinuxUnLockMutex(&gPVRSRVLock);
+
+	kref_get(&psTimeline->sKref);
+	psAllocSyncData->psTimeline = psTimeline;
+	psAllocSyncData->psFile = psFile;
+
+	if (copy_to_user(pvData, &sData, sizeof(sData)))
+		goto err_release_file;
+
+	fd_install(iFd, psFile);
+	return 0;
+
+err_release_file:
+	fput(psFile);
+	put_unused_fd(iFd);
+	return err;
+err_release_sync_info:
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+	PVRSRVReleaseSyncInfoKM(psAllocSyncData->psSyncInfo->psBase);
+	LinuxUnLockMutex(&gPVRSRVLock);
+err_free_sync_info:
+	kfree(psAllocSyncData->psSyncInfo);
+err_free_alloc_sync_data:
+	kfree(psAllocSyncData);
+err_put_fd:
+	put_unused_fd(iFd);
+	return err;
+}
+
+static long
+PVRSyncIOCTLCreate(struct PVR_SYNC_TIMELINE *psObj, void __user *pvData)
+{
+	struct PVR_SYNC_KERNEL_SYNC_INFO *psProvidedSyncInfo = NULL;
+	struct PVR_ALLOC_SYNC_DATA *psAllocSyncData;
+	struct PVR_SYNC_CREATE_IOCTL_DATA sData;
+	struct PVR_SYNC_DATA *psSyncData;
+	struct sync_fence *psFence;
+	struct file *psFile;
+	int err = -EFAULT, iFd = get_unused_fd_flags(O_CLOEXEC);
+
+	if (iFd < 0)
+		return iFd;
+
+	if (copy_from_user(&sData, pvData, sizeof(sData)))
+		goto err_put_fd;
+
+	if (sData.allocdSyncInfo < 0)
+		goto err_put_fd;
+
+	psAllocSyncData = PVRSyncAllocFDGet(sData.allocdSyncInfo);
+	if (!psAllocSyncData)
+		goto err_put_fd;
+
+	psProvidedSyncInfo = psAllocSyncData->psSyncInfo;
+	psAllocSyncData->psSyncInfo = NULL;
+	fput(psAllocSyncData->psFile);
+
+	if (!psProvidedSyncInfo)
+		goto err_put_fd;
+
+	psSyncData = kzalloc(sizeof(*psSyncData), GFP_KERNEL);
+	if (!psSyncData) {
+		PVRSyncReleaseSyncInfo(psProvidedSyncInfo);
+		err = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	atomic_set(&psSyncData->sRefcount, 1);
+	psSyncData->ui32WOPSnapshot =
+		psObj->psSyncInfo->psBase->psSyncData->ui32WriteOpsPending;
+	psSyncData->psSyncInfo = psProvidedSyncInfo;
+
+	mutex_lock(&psObj->sTimelineLock);
+	psSyncData->ui64Stamp = gui64SyncPointStamp++;
+	mutex_unlock(&psObj->sTimelineLock);
+
+	psFence = kzalloc(sizeof(*psFence), GFP_KERNEL);
+	if (!psFence) {
+		PVRSyncPutSyncData(psSyncData);
+		err = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	sData.name[sizeof(sData.name) - 1] = '\0';
+	strscpy(psFence->name, sData.name, sizeof(psFence->name));
+	psFence->num_pts = 1;
+	psFence->pts[0] = psSyncData;
+
+	psFile = anon_inode_getfile("pvr_sync_fence", &gsPVRFenceFOps,
+				    psFence, O_RDONLY | O_CLOEXEC);
+	if (IS_ERR_OR_NULL(psFile)) {
+		PVRSyncPutSyncData(psSyncData);
+		kfree(psFence);
+		err = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	psFence->file = psFile;
+	sData.fence = iFd;
+
+	if (copy_to_user(pvData, &sData, sizeof(sData))) {
+		fput(psFile);
+		put_unused_fd(iFd);
+		return -EFAULT;
+	}
+
+	if (psProvidedSyncInfo->psBase->psSyncData->ui32WriteOpsPending == 0)
+		wake_up_all(&gPVRSyncWaitQueue);
+
+	fd_install(iFd, psFile);
+	return 0;
+
+err_put_fd:
+	put_unused_fd(iFd);
+	return err;
+}
+
+static long
+PVRSyncIOCTLDebug(struct PVR_SYNC_TIMELINE *psObj, void __user *pvData)
+{
+	struct PVR_SYNC_DEBUG_IOCTL_DATA sData;
+	struct sync_fence *psFence;
+	IMG_UINT32 i, ui32Count = 0;
+
+	if (copy_from_user(&sData, pvData, sizeof(sData)))
+		return -EFAULT;
+
+	psFence = sync_fence_fdget(sData.iFenceFD);
+	if (!psFence)
+		return -EFAULT;
+
+	for (i = 0; i < psFence->num_pts && ui32Count < PVR_SYNC_DEBUG_MAX_POINTS; i++) {
+		struct PVR_SYNC_DATA *psPt = psFence->pts[i];
+		PVRSRV_KERNEL_SYNC_INFO *psKernelSyncInfo = psPt->psSyncInfo->psBase;
+
+		sData.sSync[ui32Count].sSyncData = *psKernelSyncInfo->psSyncData;
+		sData.sSync[ui32Count].sMetaData.ui64Stamp = psPt->ui64Stamp;
+		sData.sSync[ui32Count].sMetaData.ui32WriteOpsPendingSnapshot =
+			psPt->ui32WOPSnapshot;
+		ui32Count++;
+	}
+
+	sync_fence_put(psFence);
+
+	sData.ui32NumPoints = ui32Count;
+
+	if (copy_to_user(pvData, &sData, sizeof(sData)))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long
+PVRSyncIOCTL(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct PVR_SYNC_TIMELINE *psTimeline = file->private_data;
+	void __user *pvData = (void __user *)arg;
+
+	switch (cmd) {
+	case PVR_SYNC_IOC_CREATE_FENCE:
+		return PVRSyncIOCTLCreate(psTimeline, pvData);
+	case PVR_SYNC_IOC_DEBUG_FENCE:
+		return PVRSyncIOCTLDebug(psTimeline, pvData);
+	case PVR_SYNC_IOC_ALLOC_FENCE:
+		return PVRSyncIOCTLAlloc(psTimeline, pvData);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static void PVRSyncWorkQueueFunction(struct work_struct *data)
+{
+	PVRSRV_DEVICE_NODE *psDevNode =
+		(PVRSRV_DEVICE_NODE *)gsSyncServicesConnection.hDevCookie;
+	struct list_head sFreeList, *psEntry, *n;
+	unsigned long flags;
+
+	LinuxLockMutexNested(&gPVRSRVLock, PVRSRV_LOCK_CLASS_BRIDGE);
+
+	if (psDevNode)
+		SGXScheduleProcessQueuesKM(psDevNode);
+
+	INIT_LIST_HEAD(&sFreeList);
+	spin_lock_irqsave(&gSyncInfoFreeListLock, flags);
+	list_for_each_safe(psEntry, n, &gSyncInfoFreeList) {
+		struct PVR_SYNC_KERNEL_SYNC_INFO *psSyncInfo =
+			container_of(psEntry, struct PVR_SYNC_KERNEL_SYNC_INFO, sHead);
+
+		if (!PVRSyncIsSyncInfoInUse(psSyncInfo->psBase))
+			list_move_tail(psEntry, &sFreeList);
+	}
+	spin_unlock_irqrestore(&gSyncInfoFreeListLock, flags);
+
+	list_for_each_safe(psEntry, n, &sFreeList) {
+		struct PVR_SYNC_KERNEL_SYNC_INFO *psSyncInfo =
+			container_of(psEntry, struct PVR_SYNC_KERNEL_SYNC_INFO, sHead);
+
+		list_del(psEntry);
+		PVRSRVReleaseSyncInfoKM(psSyncInfo->psBase);
+		psSyncInfo->psBase = NULL;
+		kfree(psSyncInfo);
+	}
+
+	LinuxUnLockMutex(&gPVRSRVLock);
+}
+
+static const struct file_operations gsPVRSyncFOps = {
+	.owner		= THIS_MODULE,
+	.open		= PVRSyncOpen,
+	.release	= PVRSyncRelease,
+	.unlocked_ioctl	= PVRSyncIOCTL,
+};
+
+static struct miscdevice gsPVRSyncDev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "pvr_sync",
+	.fops	= &gsPVRSyncFOps,
+	.mode	= 0666,
+};
+
+IMG_INTERNAL
+int PVRSyncDeviceInit(void)
+{
+	int err = -1;
+
+	if (PVRSyncInitServices() != PVRSRV_OK) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: Failed to initialise services", __func__));
+		return -1;
+	}
+
+	gpsWorkQueue = create_freezable_workqueue("pvr_sync_workqueue");
+	if (!gpsWorkQueue) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: Failed to create pvr_sync workqueue", __func__));
+		goto err_deinit_services;
+	}
+
+	INIT_WORK(&gsWork, PVRSyncWorkQueueFunction);
+
+	err = misc_register(&gsPVRSyncDev);
+	if (err) {
+		PVR_DPF((PVR_DBG_ERROR, "%s: Failed to register pvr_sync misc device (err=%d)",
+			 __func__, err));
+		destroy_workqueue(gpsWorkQueue);
+		gpsWorkQueue = NULL;
+		goto err_deinit_services;
+	}
+
+	return 0;
+
+err_deinit_services:
+	PVRSyncCloseServices();
+	return err;
+}
+
+IMG_INTERNAL
+void PVRSyncDeviceDeInit(void)
+{
+	misc_deregister(&gsPVRSyncDev);
+	if (gpsWorkQueue) {
+		destroy_workqueue(gpsWorkQueue);
+		gpsWorkQueue = NULL;
+	}
+	PVRSyncCloseServices();
+}
+
+IMG_INTERNAL
+void PVRSyncUpdateAllSyncs(void)
+{
+	IMG_BOOL bNeedToProcessQueues = IMG_FALSE;
+	struct list_head *psEntry;
+	unsigned long flags;
+
+	wake_up_all(&gPVRSyncWaitQueue);
+
+	mutex_lock(&gTimelineListLock);
+	list_for_each(psEntry, &gTimelineList) {
+		struct PVR_SYNC_TIMELINE *psTimeline =
+			container_of(psEntry, struct PVR_SYNC_TIMELINE, sTimelineList);
+		IMG_UINT32 ui32WOC =
+			psTimeline->psSyncInfo->psBase->psSyncData->ui32WriteOpsComplete;
+
+		if (ui32WOC != psTimeline->ui32LastWriteOpsComplete) {
+			psTimeline->ui32LastWriteOpsComplete = ui32WOC;
+			bNeedToProcessQueues = IMG_TRUE;
+		}
+	}
+	mutex_unlock(&gTimelineListLock);
+
+	spin_lock_irqsave(&gSyncInfoFreeListLock, flags);
+	if (!list_empty(&gSyncInfoFreeList))
+		bNeedToProcessQueues = IMG_TRUE;
+	spin_unlock_irqrestore(&gSyncInfoFreeListLock, flags);
+
+	if (bNeedToProcessQueues && gpsWorkQueue)
+		queue_work(gpsWorkQueue, &gsWork);
+}
+
+static void
+CopyKernelSyncInfoToDeviceSyncObject(PVRSRV_KERNEL_SYNC_INFO *psSyncInfo,
+				     PVRSRV_DEVICE_SYNC_OBJECT *psSyncObject)
+{
+	psSyncObject->sReadOpsCompleteDevVAddr  = psSyncInfo->sReadOpsCompleteDevVAddr;
+	psSyncObject->sWriteOpsCompleteDevVAddr = psSyncInfo->sWriteOpsCompleteDevVAddr;
+	psSyncObject->sReadOps2CompleteDevVAddr = psSyncInfo->sReadOps2CompleteDevVAddr;
+	psSyncObject->ui32WriteOpsPendingVal = psSyncInfo->psSyncData->ui32WriteOpsPending;
+	psSyncObject->ui32ReadOpsPendingVal  = psSyncInfo->psSyncData->ui32ReadOpsPending;
+	psSyncObject->ui32ReadOps2PendingVal = psSyncInfo->psSyncData->ui32ReadOps2Pending;
+}
+
+static IMG_BOOL
+AddSyncInfoToArray(PVRSRV_KERNEL_SYNC_INFO *psSyncInfo,
+		   IMG_UINT32 ui32SyncPointLimit,
+		   IMG_UINT32 *pui32NumRealSyncs,
+		   PVRSRV_KERNEL_SYNC_INFO *apsSyncInfo[])
+{
+	if (*pui32NumRealSyncs == ui32SyncPointLimit) {
+		PVR_DPF((PVR_DBG_WARNING, "%s: Ran out of source syncs %d == %d",
+			 __func__, *pui32NumRealSyncs, ui32SyncPointLimit));
+		return IMG_FALSE;
+	}
+
+	apsSyncInfo[*pui32NumRealSyncs] = psSyncInfo;
+	(*pui32NumRealSyncs)++;
+	return IMG_TRUE;
+}
+
+static IMG_BOOL
+ExpandAndDeDuplicateFenceSyncs(IMG_UINT32 ui32NumSyncs,
+			       int aiFenceFds[],
+			       IMG_UINT32 ui32SyncPointLimit,
+			       struct sync_fence *apsFence[],
+			       IMG_UINT32 *pui32NumRealSyncs,
+			       PVRSRV_KERNEL_SYNC_INFO *apsSyncInfo[])
+{
+	IMG_UINT32 i, j, k, ui32FenceIndex = 0;
+	IMG_BOOL bRet = IMG_TRUE;
+
+	*pui32NumRealSyncs = 0;
+
+	for (i = 0; i < ui32NumSyncs; i++) {
+		if (aiFenceFds[i] < 0)
+			continue;
+
+		apsFence[ui32FenceIndex] = sync_fence_fdget(aiFenceFds[i]);
+		if (!apsFence[ui32FenceIndex]) {
+			PVR_DPF((PVR_DBG_ERROR, "%s: Failed to get fence from fd=%d",
+				 __func__, aiFenceFds[i]));
+			bRet = IMG_FALSE;
+			goto err_out;
+		}
+
+		for (k = 0; k < apsFence[ui32FenceIndex]->num_pts; k++) {
+			PVRSRV_KERNEL_SYNC_INFO *psSyncInfo =
+				apsFence[ui32FenceIndex]->pts[k]->psSyncInfo->psBase;
+
+			for (j = 0; j < *pui32NumRealSyncs; j++) {
+				if (PVRSyncIsDuplicate(apsSyncInfo[j], psSyncInfo))
+					break;
+			}
+
+			if (j == *pui32NumRealSyncs) {
+				if (!AddSyncInfoToArray(psSyncInfo, ui32SyncPointLimit,
+							pui32NumRealSyncs, apsSyncInfo))
+					goto err_out;
+			}
+		}
+
+		ui32FenceIndex++;
+	}
+
+err_out:
+	return bRet;
+}
+
+IMG_INTERNAL PVRSRV_ERROR
+PVRSyncPatchCCBKickSyncInfos(IMG_HANDLE    ahSyncs[SGX_MAX_SRC_SYNCS_TA],
+			     PVRSRV_DEVICE_SYNC_OBJECT asDevSyncs[SGX_MAX_SRC_SYNCS_TA],
+			     IMG_UINT32 *pui32NumSrcSyncs)
+{
+	PVRSRV_KERNEL_SYNC_INFO *apsSyncInfo[SGX_MAX_SRC_SYNCS_TA];
+	struct sync_fence *apsFence[SGX_MAX_SRC_SYNCS_TA] = {};
+	IMG_UINT32 i, ui32NumRealSrcSyncs;
+	PVRSRV_ERROR eError = PVRSRV_OK;
+
+	if (!ExpandAndDeDuplicateFenceSyncs(*pui32NumSrcSyncs,
+					    (int *)ahSyncs,
+					    SGX_MAX_SRC_SYNCS_TA,
+					    apsFence,
+					    &ui32NumRealSrcSyncs,
+					    apsSyncInfo)) {
+		eError = PVRSRV_ERROR_HANDLE_NOT_FOUND;
+		goto err_put_fence;
+	}
+
+	for (i = 0; i < ui32NumRealSrcSyncs; i++) {
+		PVRSRV_KERNEL_SYNC_INFO *psSyncInfo = apsSyncInfo[i];
+
+		PVR_TTRACE_SYNC_OBJECT(PVRSRV_TRACE_GROUP_KICK, KICK_TOKEN_SRC_SYNC,
+				       psSyncInfo, PVRSRV_SYNCOP_SAMPLE);
+
+		CopyKernelSyncInfoToDeviceSyncObject(psSyncInfo, &asDevSyncs[i]);
+
+		/* Texture dependencies are read operations */
+		psSyncInfo->psSyncData->ui32ReadOpsPending++;
+
+		ahSyncs[i] = psSyncInfo;
+	}
+
+	*pui32NumSrcSyncs = ui32NumRealSrcSyncs;
+
+err_put_fence:
+	for (i = 0; i < SGX_MAX_SRC_SYNCS_TA && apsFence[i]; i++)
+		sync_fence_put(apsFence[i]);
+	return eError;
+}
+
+IMG_INTERNAL PVRSRV_ERROR
+PVRSyncPatchTransferSyncInfos(IMG_HANDLE    ahSyncs[SGX_MAX_SRC_SYNCS_TA],
+			      PVRSRV_DEVICE_SYNC_OBJECT asDevSyncs[SGX_MAX_SRC_SYNCS_TA],
+			      IMG_UINT32 *pui32NumSrcSyncs)
+{
+	struct PVR_ALLOC_SYNC_DATA *psTransferSyncData;
+	PVRSRV_KERNEL_SYNC_INFO *psSyncInfo;
+	PVRSRV_ERROR eError = PVRSRV_OK;
+
+	psTransferSyncData = PVRSyncAllocFDGet((int)(uintptr_t)ahSyncs[0]);
+	if (!psTransferSyncData || !psTransferSyncData->psSyncInfo) {
+		if (psTransferSyncData)
+			fput(psTransferSyncData->psFile);
+		PVR_DPF((PVR_DBG_ERROR, "%s: Failed to get PVR_SYNC_DATA from supplied fd",
+			 __func__));
+		return PVRSRV_ERROR_HANDLE_NOT_FOUND;
+	}
+
+	psSyncInfo = psTransferSyncData->psSyncInfo->psBase;
+
+	PVR_TTRACE_SYNC_OBJECT(PVRSRV_TRACE_GROUP_TRANSFER, TRANSFER_TOKEN_SRC_SYNC,
+			       psSyncInfo, PVRSRV_SYNCOP_SAMPLE);
+
+	CopyKernelSyncInfoToDeviceSyncObject(psSyncInfo, &asDevSyncs[0]);
+	CopyKernelSyncInfoToDeviceSyncObject(
+		psTransferSyncData->psTimeline->psSyncInfo->psBase,
+		&asDevSyncs[1]);
+
+	/* Treat fence TQs as write operations */
+	psSyncInfo->psSyncData->ui32WriteOpsPending++;
+	psTransferSyncData->psTimeline->psSyncInfo->psBase->psSyncData->ui32WriteOpsPending++;
+
+	ahSyncs[0] = psSyncInfo;
+	ahSyncs[1] = psTransferSyncData->psTimeline->psSyncInfo->psBase;
+
+	*pui32NumSrcSyncs = 2;
+
+	fput(psTransferSyncData->psFile);
+	return eError;
+}
+
+IMG_INTERNAL PVRSRV_ERROR
+PVRSyncFencesToSyncInfos(PVRSRV_KERNEL_SYNC_INFO *apsSyncs[],
+			 IMG_UINT32 *pui32NumSyncs,
+			 struct sync_fence *apsFence[SGX_MAX_SRC_SYNCS_TA])
+{
+	PVRSRV_KERNEL_SYNC_INFO *apsSyncInfo[SGX_MAX_SRC_SYNCS_TA];
+	IMG_UINT32 i, ui32NumRealSrcSyncs;
+
+	memset(apsFence, 0, sizeof(struct sync_fence *) * SGX_MAX_SRC_SYNCS_TA);
+
+	if (!ExpandAndDeDuplicateFenceSyncs(*pui32NumSyncs,
+					    (int *)apsSyncs,
+					    *pui32NumSyncs,
+					    apsFence,
+					    &ui32NumRealSrcSyncs,
+					    apsSyncInfo)) {
+		for (i = 0; i < SGX_MAX_SRC_SYNCS_TA && apsFence[i]; i++)
+			sync_fence_put(apsFence[i]);
+		return PVRSRV_ERROR_HANDLE_NOT_FOUND;
+	}
+
+	for (i = 0; i < ui32NumRealSrcSyncs; i++)
+		apsSyncs[i] = apsSyncInfo[i];
+
+	*pui32NumSyncs = ui32NumRealSrcSyncs;
+	return PVRSRV_OK;
+}
