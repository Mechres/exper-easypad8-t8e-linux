From ce71b02558f6ea58ad9be25dc94ca459876398d3 Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:34:59 +0300
Subject: [PATCH 11/11] pvrsrvkm: implement self-contained /dev/pvr_sync for
 Linux 7.2

The stock window-surface path needs Android native fences. Port openpvrsgx's
pvr_sync without the staging Android sync framework (PVR_SYNC_SELF_CONTAINED):
/dev/pvr_sync allocates and creates fences; fence fds are anon inodes that
support poll, SYNC_IOC_WAIT, SYNC_IOC_MERGE and SYNC_IOC_FENCE_INFO, and are
signalled from the SGX MISR and software sync completion.

---
 Kbuild                                       |    5 +-
 include4/pvr_sync_user.h                     |  125 ++
 services4/srvkm/bridged/bridged_pvr_bridge.c |   12 +-
 services4/srvkm/common/deviceclass.c         |   18 +-
 services4/srvkm/common/queue.c               |   12 +-
 services4/srvkm/env/linux/pvr_sync.c         | 1129 ++++++++++++++++++
 services4/srvkm/env/linux/pvr_sync.h         |   38 +
 7 files changed, 1319 insertions(+), 20 deletions(-)
 create mode 100644 include4/pvr_sync_user.h
 create mode 100644 services4/srvkm/env/linux/pvr_sync.c
 create mode 100644 services4/srvkm/env/linux/pvr_sync.h

diff --git a/Kbuild b/Kbuild
index 1796c46..9e1657c 100644
--- a/Kbuild
+++ b/Kbuild
@@ -40,8 +40,8 @@ ccflags-y += -DSUPPORT_SRVINIT -DSUPPORT_SGX -DSUPPORT_HW_RECOVERY -DPVR_SECURE_
 	-DSUPPORT_LISR_MISR_SYNC -DSUPPORT_SGX_NEW_STATUS_VALS \
 	-DSUPPORT_MEMINFO_IDS
 # stock structure layout and ioctl numbering of the Android build (ION and native fence fields, the two
-# ION ioctls) without the ION/sync functionality, which mainline does not have
-ccflags-y += -DPVR_T8E_ABI_1_12
+# ION ioctls) plus the self-contained /dev/pvr_sync implementation for mainline Linux
+ccflags-y += -DPVR_T8E_ABI_1_12 -DPVR_ANDROID_NATIVE_WINDOW_HAS_SYNC -DPVR_SYNC_SELF_CONTAINED
 # ION buffers from the stock gralloc arrive as dma-buf fds (from the ion_compat /dev/ion driver);
 # services import them with the generic dma-buf API (env/linux/ion.c), no in-kernel ION
 ccflags-y += -DSUPPORT_ION -DPVR_ION_DMABUF_COMPAT
@@ -92,6 +92,7 @@ pvrsrvkm-y := \
 	services4/srvkm/env/linux/proc.o \
 	services4/srvkm/env/linux/pvr_bridge_k.o \
 	services4/srvkm/env/linux/pvr_debug.o \
+	services4/srvkm/env/linux/pvr_sync.o \
 	services4/system/$(PVR_SYSTEM)/sysconfig.o \
 	services4/system/$(PVR_SYSTEM)/sysutils_linux.o
 
