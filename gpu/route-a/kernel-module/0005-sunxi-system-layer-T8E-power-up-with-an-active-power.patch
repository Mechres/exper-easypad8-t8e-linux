+/*
+ * Allwinner A31/A31s power-up, replayed from the stock pvrsrvkm
+ * (EnableSystemClocks/EnableSGXClocks, DDK 1.12): enable the vdd-gpu rail,
+ * clear PRCM GPU_PWROFF_GATING, release the reset, start PLL8 (mem/hyd) and
+ * PLL9 (core), then open the gates in the stock order hyd, core, AHB, mem.
+ * Raw CCU writes for now; the clock framework comes later.
+ */
+#define SUNXI_CCU_BASE		0x01c20000
+#define SUNXI_PRCM_BASE		0x01f01400
+#define SUNXI_PRCM_GPU_PWROFF	0x118
+#define SUNXI_CCU_PLL8		0x038
+#define SUNXI_CCU_PLL9		0x044
+#define SUNXI_CCU_BUS_GATE1	0x064
+#define SUNXI_CCU_GPU_CORE	0x1a0
+#define SUNXI_CCU_GPU_MEM	0x1a4
+#define SUNXI_CCU_GPU_HYD	0x1a8
+#define SUNXI_CCU_BUS_RST1	0x2c4
+#define SUNXI_GPU_BIT		BIT(20)
+#define SUNXI_GPU_EXTRA_BITS	(BIT(21) | BIT(22))	/* set on stock Android, undocumented */
+
+static int SunxiPLLOn(void __iomem *reg, u32 val)
+{
+	u32 v;
+
+	writel(val & ~BIT(31), reg);
+	writel(val, reg);
+	return readl_poll_timeout(reg, v, v & BIT(28), 100, 20000);
+}
+
+static PVRSRV_ERROR SunxiGPUPowerOn(SYS_SPECIFIC_DATA *psSysSpecData)
+{
+	struct device *dev = &gpsPVRLDMDev->dev;
+	void __iomem *ccu, *prcm;
+	int err;
+
+	if (psSysSpecData->bSunxiPowered)
+		return PVRSRV_OK;
+
+	if (!psSysSpecData->pvSunxiCCU)
+	{
+		psSysSpecData->pvSunxiCCU = ioremap(SUNXI_CCU_BASE, 0x400);
+		psSysSpecData->pvSunxiPRCM = ioremap(SUNXI_PRCM_BASE & ~0xfff, 0x1000);
+		if (!psSysSpecData->pvSunxiCCU || !psSysSpecData->pvSunxiPRCM)
+			return PVRSRV_ERROR_UNABLE_TO_ENABLE_CLOCK;
+	}
+	ccu = psSysSpecData->pvSunxiCCU;
+	prcm = psSysSpecData->pvSunxiPRCM + (SUNXI_PRCM_BASE & 0xfff);
+
+	if (!psSysSpecData->psSunxiVdd)
+	{
+		struct regulator *vdd = regulator_get(dev, "gpu");
+
+		if (IS_ERR(vdd))
+		{
+			dev_err(dev, "no gpu regulator: %ld\n", PTR_ERR(vdd));
+			return PVRSRV_ERROR_UNABLE_TO_ENABLE_CLOCK;
+		}
+		psSysSpecData->psSunxiVdd = vdd;
+	}
+	regulator_set_voltage(psSysSpecData->psSunxiVdd, 1200000, 1200000);
+	err = regulator_enable(psSysSpecData->psSunxiVdd);
+	if (err)
+	{
+		dev_err(dev, "gpu regulator enable failed: %d\n", err);
+		return PVRSRV_ERROR_UNABLE_TO_ENABLE_CLOCK;
+	}
+
+	writel(readl(prcm + SUNXI_PRCM_GPU_PWROFF) & ~1, prcm + SUNXI_PRCM_GPU_PWROFF);
+	msleep(2);
+	writel(readl(ccu + SUNXI_CCU_BUS_GATE1) | SUNXI_GPU_EXTRA_BITS, ccu + SUNXI_CCU_BUS_GATE1);
+	writel(readl(ccu + SUNXI_CCU_BUS_RST1) | SUNXI_GPU_EXTRA_BITS, ccu + SUNXI_CCU_BUS_RST1);
+
+	if (SunxiPLLOn(ccu + SUNXI_CCU_PLL8, 0x93000d00) ||	/* ~336 MHz */
+	    SunxiPLLOn(ccu + SUNXI_CCU_PLL9, 0x93001801))	/* 300 MHz */
+	{
+		dev_err(dev, "GPU PLLs did not lock\n");
+		return PVRSRV_ERROR_UNABLE_TO_ENABLE_CLOCK;
+	}
+	psSysSpecData->bSunxiPowered = IMG_TRUE;
+	dev_info(dev, "SGX powered: PLL8 %08x PLL9 %08x core %08x\n",
+		 readl(ccu + SUNXI_CCU_PLL8), readl(ccu + SUNXI_CCU_PLL9),
+		 readl(ccu + SUNXI_CCU_GPU_CORE));
+	return PVRSRV_OK;
+}
+
+/*
+ * Active power management cycles these around every SGX power transition; SGXInitialise
+ * (with the init scripts from user space) runs again after each power-up.
+ * Stock gate order: hyd, core, AHB, mem.
+ */
+static PVRSRV_ERROR SunxiSGXClocksOn(SYS_SPECIFIC_DATA *psSysSpecData)
+{
+	void __iomem *ccu = psSysSpecData->pvSunxiCCU;
+
+	if (!psSysSpecData->bSunxiPowered)
+		return PVRSRV_ERROR_UNABLE_TO_ENABLE_CLOCK;
+	writel(readl(ccu + SUNXI_CCU_BUS_RST1) | SUNXI_GPU_BIT, ccu + SUNXI_CCU_BUS_RST1);
+	writel(0x80000000, ccu + SUNXI_CCU_GPU_HYD);		/* PLL8 */
+	writel(0x84000000, ccu + SUNXI_CCU_GPU_CORE);		/* PLL9 */
+	writel(readl(ccu + SUNXI_CCU_BUS_GATE1) | SUNXI_GPU_BIT, ccu + SUNXI_CCU_BUS_GATE1);
+	writel(0x80000000, ccu + SUNXI_CCU_GPU_MEM);		/* PLL8 */
+	udelay(10);
+	return PVRSRV_OK;
+}
+
+static IMG_VOID SunxiSGXClocksOff(SYS_SPECIFIC_DATA *psSysSpecData)
+{
+	void __iomem *ccu = psSysSpecData->pvSunxiCCU;
+
+	if (!psSysSpecData->bSunxiPowered)
+		return;
+	writel(0, ccu + SUNXI_CCU_GPU_MEM);
+	writel(readl(ccu + SUNXI_CCU_BUS_GATE1) & ~SUNXI_GPU_BIT, ccu + SUNXI_CCU_BUS_GATE1);
+	writel(0x04000000, ccu + SUNXI_CCU_GPU_CORE);
+	writel(0, ccu + SUNXI_CCU_GPU_HYD);
+	writel(readl(ccu + SUNXI_CCU_BUS_RST1) & ~SUNXI_GPU_BIT, ccu + SUNXI_CCU_BUS_RST1);
+}
+
+static IMG_VOID SunxiGPUPowerOff(SYS_SPECIFIC_DATA *psSysSpecData)
+{
+	void __iomem *ccu = psSysSpecData->pvSunxiCCU;
+	void __iomem *prcm;
+
+	if (!psSysSpecData->bSunxiPowered)
+		return;
+	prcm = psSysSpecData->pvSunxiPRCM + (SUNXI_PRCM_BASE & 0xfff);
+
+	writel(0, ccu + SUNXI_CCU_GPU_MEM);
+	writel(readl(ccu + SUNXI_CCU_BUS_GATE1) & ~(SUNXI_GPU_BIT | SUNXI_GPU_EXTRA_BITS), ccu + SUNXI_CCU_BUS_GATE1);
+	writel(0x04000000, ccu + SUNXI_CCU_GPU_CORE);
+	writel(0, ccu + SUNXI_CCU_GPU_HYD);
+	writel(readl(ccu + SUNXI_CCU_BUS_RST1) & ~(SUNXI_GPU_BIT | SUNXI_GPU_EXTRA_BITS), ccu + SUNXI_CCU_BUS_RST1);
+	writel(readl(prcm + SUNXI_PRCM_GPU_PWROFF) | 1, prcm + SUNXI_PRCM_GPU_PWROFF);
+	regulator_disable(psSysSpecData->psSunxiVdd);
+	psSysSpecData->bSunxiPowered = IMG_FALSE;
+}
