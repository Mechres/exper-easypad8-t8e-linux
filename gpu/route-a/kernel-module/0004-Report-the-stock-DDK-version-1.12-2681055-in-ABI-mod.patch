From f3d20d744f948076bb34b0fcefa64cd76de7826c Mon Sep 17 00:00:00 2001
From: Mechres <164776284+Mechres@users.noreply.github.com>
Date: Sat, 31 Oct 2026 07:09:55 +0300
Subject: [PATCH 04/11] Report the stock DDK version (1.12@2681055) in ABI mode

PVRSRVCompatCheckKM and the microkernel check compare DDK version 0x10c00 and
build 2681055 exactly. All 110 ioctl numbers match the stock dispatch table
(routeA/compare-ids.sh).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include4/pvrversion.h | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/include4/pvrversion.h b/include4/pvrversion.h
index 2b86b07..d076b1e 100644
--- a/include4/pvrversion.h
+++ b/include4/pvrversion.h
@@ -48,6 +48,24 @@ CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 #define PVR_STR(X) #X
 #define PVR_STR2(X) PVR_STR(X)
 
+#if defined(PVR_T8E_ABI_1_12)
+/*
+ * Report the version of the stock Allwinner A31/A31s Android DDK, whose user space this build
+ * serves; PVRSRVCompatCheckKM and the microkernel check compare these numbers exactly.
+ */
+#define PVRVERSION_MAJ               1
+#define PVRVERSION_MIN               12
+#define PVRVERSION_FAMILY           "sgxddk"
+#define PVRVERSION_BRANCHNAME       "1.12"
+#define PVRVERSION_BUILD             2681055
+#define PVRVERSION_BSCONTROL        "SGX_DDK_Android_RSCompute"
+#define PVRVERSION_STRING           "SGX_DDK_Android_RSCompute sgxddk 1.12@" PVR_STR2(PVRVERSION_BUILD)
+#define PVRVERSION_STRING_SHORT     "1.12@" PVR_STR2(PVRVERSION_BUILD)
+#define COPYRIGHT_TXT               "Copyright (c) Imagination Technologies Ltd. All Rights Reserved."
+#define PVRVERSION_BUILD_HI          268
+#define PVRVERSION_BUILD_LO          1055
+#define PVRVERSION_STRING_NUMERIC    PVR_STR2(PVRVERSION_MAJ) "." PVR_STR2(PVRVERSION_MIN) "." PVR_STR2(PVRVERSION_BUILD_HI) "." PVR_STR2(PVRVERSION_BUILD_LO)
+#else
 #define PVRVERSION_MAJ               1
 #define PVRVERSION_MIN               14
 
@@ -64,5 +82,6 @@ CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 #define PVRVERSION_BUILD_HI          384
 #define PVRVERSION_BUILD_LO          1212
 #define PVRVERSION_STRING_NUMERIC    PVR_STR2(PVRVERSION_MAJ) "." PVR_STR2(PVRVERSION_MIN) "." PVR_STR2(PVRVERSION_BUILD_HI) "." PVR_STR2(PVRVERSION_BUILD_LO)
+#endif /* PVR_T8E_ABI_1_12 */
 
 #endif /* _PVRVERSION_H_ */
-- 
