diff --git a/services4/srvkm/env/linux/ion.c b/services4/srvkm/env/linux/ion.c
new file mode 100644
index 0000000..cbc4d6f
--- /dev/null
+++ b/services4/srvkm/env/linux/ion.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * ION interoperability for the services, on top of the generic dma-buf API (see ion.h).
+ *
+ * IonImportBufferAndAcquirePhysAddr() takes up to a few dma-buf descriptors (one per
+ * plane), attaches them to the SGX device and returns the system physical address of
+ * every page, plus a kernel mapping of the first buffer. The first dma-buf pointer is
+ * the "unique" key the services use to share sync objects between imports.
+ */
+#include <linux/dma-buf.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/iosys-map.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+
+#include "services_headers.h"
+#include "linkage.h"
+#include "ion.h"
+
+MODULE_IMPORT_NS("DMA_BUF");
+
+#define MAX_IMPORT_ION_FDS	3
+
+typedef struct _ION_IMPORT_DATA_
+{
+	IMG_UINT32		ui32NumBuffers;
+	struct dma_buf		*apsDmaBuf[MAX_IMPORT_ION_FDS];
+	struct dma_buf_attachment *apsAttach[MAX_IMPORT_ION_FDS];
+	struct sg_table		*apsSgt[MAX_IMPORT_ION_FDS];
+	struct iosys_map	sMap0;
+	IMG_SYS_PHYADDR		*psSysPhysAddr;
+} ION_IMPORT_DATA;
+
+PVRSRV_ERROR IonInit(IMG_VOID)
+{
+	return PVRSRV_OK;
+}
+
+IMG_VOID IonDeinit(IMG_VOID)
+{
+}
+
+static IMG_VOID IonReleaseImport(ION_IMPORT_DATA *psImportData)
+{
+	IMG_UINT32 i;
+
+	if (psImportData->sMap0.vaddr)
+		dma_buf_vunmap_unlocked(psImportData->apsDmaBuf[0], &psImportData->sMap0);
+	for (i = 0; i < psImportData->ui32NumBuffers; i++)
+	{
+		if (psImportData->apsSgt[i])
+			dma_buf_unmap_attachment_unlocked(psImportData->apsAttach[i],
+							  psImportData->apsSgt[i], DMA_BIDIRECTIONAL);
+		if (psImportData->apsAttach[i])
+			dma_buf_detach(psImportData->apsDmaBuf[i], psImportData->apsAttach[i]);
+		if (psImportData->apsDmaBuf[i])
+			dma_buf_put(psImportData->apsDmaBuf[i]);
+	}
+	kfree(psImportData->psSysPhysAddr);
+	kfree(psImportData);
+}
+
+PVRSRV_ERROR IonImportBufferAndAcquirePhysAddr(IMG_HANDLE hIonDev,
+					       IMG_UINT32 ui32NumFDs,
+					       IMG_INT32 *pi32BufferFDs,
+					       IMG_UINT32 *pui32PageCount,
+					       IMG_SYS_PHYADDR **ppsSysPhysAddr,
+					       IMG_PVOID *ppvKernAddr0,
+					       IMG_HANDLE *phPriv,
+					       IMG_HANDLE *phUnique)
+{
+	struct device *dev = PVRLDMGetDevice();
+	ION_IMPORT_DATA *psImportData;
+	IMG_UINT32 i, ui32PageCount = 0, ui32Page = 0;
+	struct scatterlist *sg;
+	unsigned int n;
+
+	PVR_UNREFERENCED_PARAMETER(hIonDev);
+
+	if (ui32NumFDs == 0 || ui32NumFDs > MAX_IMPORT_ION_FDS)
+		return PVRSRV_ERROR_INVALID_PARAMS;
+
+	psImportData = kzalloc(sizeof(*psImportData), GFP_KERNEL);
+	if (!psImportData)
+		return PVRSRV_ERROR_OUT_OF_MEMORY;
+
+	for (i = 0; i < ui32NumFDs; i++)
+	{
+		struct dma_buf *psDmaBuf = dma_buf_get(pi32BufferFDs[i]);
+
+		if (IS_ERR(psDmaBuf))
+			goto fail;
+		psImportData->apsDmaBuf[i] = psDmaBuf;
+		psImportData->ui32NumBuffers = i + 1;
+
+		psImportData->apsAttach[i] = dma_buf_attach(psDmaBuf, dev);
+		if (IS_ERR(psImportData->apsAttach[i]))
+		{
+			psImportData->apsAttach[i] = NULL;
+			goto fail;
+		}
+		psImportData->apsSgt[i] = dma_buf_map_attachment_unlocked(psImportData->apsAttach[i],
+									  DMA_BIDIRECTIONAL);
+		if (IS_ERR(psImportData->apsSgt[i]))
+		{
+			psImportData->apsSgt[i] = NULL;
+			goto fail;
+		}
+		for_each_sgtable_dma_sg(psImportData->apsSgt[i], sg, n)
+			ui32PageCount += PAGE_ALIGN(sg_dma_len(sg)) >> PAGE_SHIFT;
+	}
+
+	psImportData->psSysPhysAddr = kcalloc(ui32PageCount, sizeof(IMG_SYS_PHYADDR), GFP_KERNEL);
+	if (!psImportData->psSysPhysAddr)
+		goto fail;
+
+	/* no IOMMU on the A31: DMA addresses are physical addresses */
+	for (i = 0; i < ui32NumFDs; i++)
+	{
+		for_each_sgtable_dma_sg(psImportData->apsSgt[i], sg, n)
+		{
+			dma_addr_t addr = sg_dma_address(sg);
+			IMG_UINT32 ui32Pages = PAGE_ALIGN(sg_dma_len(sg)) >> PAGE_SHIFT, j;
+
+			for (j = 0; j < ui32Pages; j++)
+				psImportData->psSysPhysAddr[ui32Page++].uiAddr = addr + j * PAGE_SIZE;
+		}
+	}
+
+	if (ppvKernAddr0)
+	{
+		if (dma_buf_vmap_unlocked(psImportData->apsDmaBuf[0], &psImportData->sMap0))
+			psImportData->sMap0.vaddr = NULL;
+		*ppvKernAddr0 = psImportData->sMap0.vaddr;
+	}
+
+	*pui32PageCount = ui32PageCount;
+	*ppsSysPhysAddr = psImportData->psSysPhysAddr;
+	*phPriv = psImportData;
+	*phUnique = (IMG_HANDLE)psImportData->apsDmaBuf[0];
+	return PVRSRV_OK;
+
+fail:
+	PVR_DPF((PVR_DBG_ERROR, "%s: could not import dma-buf fd(s)", __func__));
+	IonReleaseImport(psImportData);
+	return PVRSRV_ERROR_BAD_MAPPING;
+}
+
+IMG_VOID IonUnimportBufferAndReleasePhysAddr(IMG_HANDLE hPriv)
+{
+	IonReleaseImport((ION_IMPORT_DATA *)hPriv);
+}
diff --git a/services4/srvkm/env/linux/ion.h b/services4/srvkm/env/linux/ion.h
new file mode 100644
