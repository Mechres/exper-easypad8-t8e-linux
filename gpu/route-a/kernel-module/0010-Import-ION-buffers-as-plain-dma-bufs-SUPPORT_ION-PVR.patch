--- /dev/null
+++ b/services4/srvkm/env/linux/ion.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: (GPL-2.0 OR MIT) */
+/*
+ * ION interoperability for the services, on top of the generic dma-buf API.
+ *
+ * Mainline Linux has no Android ION any more. User space gets its buffers from a
+ * separate /dev/ion compatibility driver that hands out dma-buf file descriptors;
+ * the services only ever need to import such descriptors and learn the pages
+ * behind them, which works for any dma-buf.
+ */
+#ifndef __IMG_LINUX_ION_H__
+#define __IMG_LINUX_ION_H__
+
+#if defined(SUPPORT_ION)
+#include "img_types.h"
+#include "servicesext.h"
+
+#define ION_CLIENT_NAME_SIZE	50
+
+struct ion_client;
+
+PVRSRV_ERROR IonInit(IMG_VOID);
+IMG_VOID IonDeinit(IMG_VOID);
+
+PVRSRV_ERROR IonImportBufferAndAcquirePhysAddr(IMG_HANDLE hIonDev,
+					       IMG_UINT32 ui32NumFDs,
+					       IMG_INT32 *pi32BufferFDs,
+					       IMG_UINT32 *pui32PageCount,
+					       IMG_SYS_PHYADDR **ppsSysPhysAddr,
+					       IMG_PVOID *ppvKernAddr0,
+					       IMG_HANDLE *phPriv,
+					       IMG_HANDLE *phUnique);
+
+IMG_VOID IonUnimportBufferAndReleasePhysAddr(IMG_HANDLE hPriv);
+#endif /* defined(SUPPORT_ION) */
+
+#endif /* __IMG_LINUX_ION_H__ */
