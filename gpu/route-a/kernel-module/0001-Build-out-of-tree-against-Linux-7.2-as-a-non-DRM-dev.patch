+#define	HZ_TO_MHZ(m) ((m) / ONE_MHZ)
+
+struct clk *h_ahb_gpu, *h_gpu_coreclk, *h_gpu_hydclk, *h_gpu_memclk, *h_gpu_hydpll, *h_gpu_corepll;
+struct regulator *gpu_power;
+
+#if defined(LDM_PLATFORM) 
