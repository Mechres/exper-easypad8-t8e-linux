+/* SPDX-License-Identifier: (GPL-2.0 OR MIT) */
+/*
+ * Compatibility shims for kernels newer than the 6.1 this DDK was written
+ * for. Force-included into every kbuild object (see kbuild/Makefile.template).
+ */
+#ifndef PVR_LINUX_COMPAT_H
+#define PVR_LINUX_COMPAT_H
+
+#include <linux/version.h>
+#include <linux/preempt.h>
+#include <linux/string.h>
+#include <linux/timer.h>
+
+#ifndef in_irq
+#define in_irq()	in_hardirq()
+#endif
+
+#ifndef from_timer
+#define from_timer(var, callback_timer, timer_fieldname) \
+	timer_container_of(var, callback_timer, timer_fieldname)
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+#define del_timer_sync(t)	timer_delete_sync(t)
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+/* strncpy() is gone; every DDK user copies a string into a buffer of n bytes. */
+static inline char *pvr_strncpy(char *dst, const char *src, size_t n)
+{
+	if (n)
+		strscpy_pad(dst, src, n);
+	return dst;
+}
+#define strncpy(d, s, n)	pvr_strncpy(d, s, n)
+#endif
+
+#endif /* PVR_LINUX_COMPAT_H */
+
+/* --- additions for the 1.14 tree (route A) --- */
+#ifndef PVR_LINUX_COMPAT_114_H
+#define PVR_LINUX_COMPAT_114_H
+#include <linux/io.h>
+#include <linux/mm.h>
+#define ioremap_nocache(addr, size)	ioremap(addr, size)
+#define page_cache_release(page)	put_page(page)
+#ifndef VERIFY_READ
+#define VERIFY_READ	0
+#define VERIFY_WRITE	1
+#endif
+#endif
