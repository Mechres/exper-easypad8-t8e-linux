+# Out-of-tree build of pvrsrvkm for the Exper T8E (Allwinner A31s, SGX544 MP2 rev 1.1.5), ABI-compatible
+# with the stock Allwinner DDK 1.12@2681055 Android user space. Build:
+#   make -C <kernel build dir> M=$PWD ARCH=arm CROSS_COMPILE=... modules
+#
+# Option set from the stock module's SGX_BUILD_OPTIONS (0x1036a41c): EDM status debug, HW recovery,
+# secure handles, MP with 2 cores, system cache, active power management, per-context PB, HWPERF,
+# priority and low-latency scheduling; no DEBUG, no PDUMP. Stock also built ion.c, pvr_sync.c and
+# deviceclass.c (SUPPORT_ION, SUPPORT_NATIVE_FENCE_SYNC, SUPPORT_PVRSRV_DEVICE_CLASS).
+
+obj-m := pvrsrvkm.o
+
+PVR_SYSTEM := sunxi
+
+ccflags-y := -I$(src)/compat-include \
+	-I$(src) -I$(src)/include4 -I$(src)/services4/include -I$(src)/services4/include/env/linux \
+	-I$(src)/services4/system/include -I$(src)/services4/system/$(PVR_SYSTEM) \
+	-I$(src)/services4/srvkm/bridged -I$(src)/services4/srvkm/bridged/sgx \
+	-I$(src)/services4/srvkm/devices/sgx -I$(src)/services4/srvkm/env/linux \
+	-I$(src)/services4/srvkm/hwdefs -I$(src)/services4/srvkm/include \
+	-include $(src)/services4/include/env/linux/pvr_linux_compat.h
+
+# platform
+ccflags-y += -DLINUX -D__linux__ -DSERVICES4 -DRELEASE -DPVR_BUILD_TYPE='"release"' \
+	-DPVRSRV_MODNAME='"pvrsrvkm"' -DPVR_LDM_DRIVER_REGISTRATION_NAME='"pvrsrvkm"' -DPVR_BUILD_DIR='"sunxi_t8e"' -DPVR_BUILD_DATE='"t8e"' \
+	-DSYS_SGX_DEV_NAME='"allwinner,sun6i-a31-gpu"' -DLDM_PLATFORM -DPVR_LDM_DEVICE_TREE \
+	-DSYS_USING_INTERRUPTS -DPVR_LINUX_USING_WORKQUEUES -DPVR_LINUX_MISR_USING_PRIVATE_WORKQUEUE \
+	-DPVR_LINUX_TIMERS_USING_WORKQUEUES -DSYS_CUSTOM_POWERLOCK_WRAP -DPVR_NO_OMAP_TIMER \
+	-DPVR_LINUX_MEM_AREA_POOL_MAX_PAGES=0 -DIMG_ADDRSPACE_PHYSADDR_BITS=32
+
+# core
+ccflags-y += -DSGX544 -DSGX_CORE_REV=115 -DSGX_FEATURE_MP -DSGX_FEATURE_MP_CORE_COUNT=2 \
+	-DSGX_FEATURE_SYSTEM_CACHE
+
+# services options (stock SGX_BUILD_OPTIONS and the stock source list)
+ccflags-y += -DSUPPORT_SRVINIT -DSUPPORT_SGX -DSUPPORT_HW_RECOVERY -DPVR_SECURE_HANDLES \
+	-DPVRSRV_USSE_EDM_STATUS_DEBUG -DSUPPORT_ACTIVE_POWER_MANAGEMENT -DSUPPORT_PERCONTEXT_PB \
+	-DSUPPORT_SGX_HWPERF -DSUPPORT_SGX_PRIORITY_SCHEDULING -DSUPPORT_SGX_LOW_LATENCY_SCHEDULING \
+	-DTRANSFER_QUEUE -DSUPPORT_SGX_EVENT_OBJECT -DSUPPORT_PVRSRV_DEVICE_CLASS \
+	-DSUPPORT_LISR_MISR_SYNC -DSUPPORT_SGX_NEW_STATUS_VALS
+
+ccflags-y += -Wno-pointer-arith -Wno-sign-conversion -fno-strict-aliasing
+
+pvrsrvkm-y := \
+	services4/srvkm/bridged/bridged_pvr_bridge.o \
+	services4/srvkm/bridged/bridged_support.o \
+	services4/srvkm/bridged/sgx/bridged_sgx_bridge.o \
+	services4/srvkm/common/buffer_manager.o \
+	services4/srvkm/common/deviceclass.o \
+	services4/srvkm/common/devicemem.o \
+	services4/srvkm/common/handle.o \
+	services4/srvkm/common/hash.o \
+	services4/srvkm/common/lists.o \
+	services4/srvkm/common/mem.o \
+	services4/srvkm/common/mem_debug.o \
+	services4/srvkm/common/metrics.o \
+	services4/srvkm/common/osfunc_common.o \
+	services4/srvkm/common/pdump_common.o \
+	services4/srvkm/common/perproc.o \
+	services4/srvkm/common/power.o \
+	services4/srvkm/common/pvrsrv.o \
+	services4/srvkm/common/queue.o \
+	services4/srvkm/common/ra.o \
+	services4/srvkm/common/refcount.o \
+	services4/srvkm/common/resman.o \
+	services4/srvkm/devices/sgx/mmu.o \
+	services4/srvkm/devices/sgx/pb.o \
+	services4/srvkm/devices/sgx/sgxinit.o \
+	services4/srvkm/devices/sgx/sgxkick.o \
+	services4/srvkm/devices/sgx/sgxpower.o \
+	services4/srvkm/devices/sgx/sgxreset.o \
+	services4/srvkm/devices/sgx/sgxtransfer.o \
+	services4/srvkm/devices/sgx/sgxutils.o \
+	services4/srvkm/env/linux/event.o \
+	services4/srvkm/env/linux/mm.o \
+	services4/srvkm/env/linux/mmap.o \
+	services4/srvkm/env/linux/module.o \
+	services4/srvkm/env/linux/mutex.o \
+	services4/srvkm/env/linux/mutils.o \
+	services4/srvkm/env/linux/osfunc.o \
+	services4/srvkm/env/linux/osperproc.o \
+	services4/srvkm/env/linux/proc.o \
+	services4/srvkm/env/linux/pvr_bridge_k.o \
+	services4/srvkm/env/linux/pvr_debug.o \
+	services4/system/$(PVR_SYSTEM)/sysconfig.o \
+	services4/system/$(PVR_SYSTEM)/sysutils_linux.o
